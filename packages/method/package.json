{
  "name": "@rickylabs/method",
  "version": "0.0.0",
  "description": "Method tools: milestone run-record render and validate, route receipt checks, run templates",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "harness-method": "./src/adapters/cli/main.ts"
