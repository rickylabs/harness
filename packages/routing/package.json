{
  "name": "@rickylabs/routing",
  "version": "0.0.0",
  "description": "Configuration-driven routing, native discovery and evaluator independence",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./config/*.json": "./config/*.json",
    "./matrix/*": "./matrix/*"
  },
  "files": [
    "dist",
    "config",
    "matrix",
    "src/discovery.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "tsc -b && node --test \"dist/**/*.test.js\" matrix/*.test.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rickylabs/subagents": "workspace:*"
  }
}
