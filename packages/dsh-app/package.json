{
  "name": "@rickylabs/dsh-app",
  "version": "0.0.0",
  "description": "Our dsh profile and bundle (cordis.patch.yml) composing every plugin package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-profile": "./dist/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./plugins/subagents": {
      "types": "./dist/plugins/subagents.d.ts",
      "default": "./dist/plugins/subagents.js"
    },
    "./plugins/board": {
      "types": "./dist/plugins/board.d.ts",
      "default": "./dist/plugins/board.js"
    },
    "./plugins/coordinator": {
      "types": "./dist/plugins/coordinator.d.ts",
      "default": "./dist/plugins/coordinator.js"
    },
    "./plugins/telemetry": {
      "types": "./dist/plugins/telemetry.d.ts",
      "default": "./dist/plugins/telemetry.js"
    },
    "./plugins/llm": {
      "types": "./dist/plugins/llm.d.ts",
      "default": "./dist/plugins/llm.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "tsc -b && node --test \"dist/**/*.test.js\"",
    "smoke:board-projection": "tsc -b && node dist/board-smoke.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rickylabs/board": "workspace:*",
    "@rickylabs/harness-contracts": "workspace:*",
    "@rickylabs/coordinator": "workspace:*",
    "@rickylabs/forge": "workspace:*",
    "@rickylabs/governance": "workspace:*",
    "@rickylabs/llm-local": "workspace:*",
    "@rickylabs/netscript-bridge": "workspace:*",
    "@rickylabs/provider-acp": "workspace:*",
    "@rickylabs/provider-claude": "workspace:*",
    "@rickylabs/provider-codex": "workspace:*",
    "@rickylabs/provider-opencode": "workspace:*",
    "@rickylabs/routing": "workspace:*",
    "@rickylabs/subagents": "workspace:*",
    "@rickylabs/telemetry": "workspace:*",
    "@deepseek-ai/dsh": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
