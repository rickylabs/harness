{
  "name": "@rickylabs/provider-agy",
  "version": "0.0.0",
  "description": "agy (Antigravity CLI) native transcript reader: tool-call descriptors from the vendor's retained conversation log",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "tsc -b && node --test \"dist/tests/**/*.test.js\" \"tests/architecture/*.test.mjs\""
  },
  "dependencies": {
    "@rickylabs/harness-contracts": "workspace:*"
  }
}
