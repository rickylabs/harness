{
  "name": "@rickylabs/provider-opencode",
  "version": "0.0.0",
  "description": "Native task adapter over a configured OpenCode server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./test-fixtures": {
      "types": "./dist/tests/fixtures/recorded-server.d.ts",
      "default": "./dist/tests/fixtures/recorded-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "tsc -b && node --test \"dist/tests/**/*.test.js\" \"tests/architecture/*.test.mjs\""
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.35",
    "@rickylabs/harness-contracts": "workspace:*",
    "@rickylabs/subagents": "workspace:*"
  }
}
