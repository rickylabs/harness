{
  "name": "@rickylabs/subagents",
  "version": "0.0.0",
  "description": "The SubagentProvider contract and the one dispatch payload every seam shares",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./config/*.json": "./config/*.json"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "tsc -b && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
