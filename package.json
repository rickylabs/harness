{
  "name": "@rickylabs/harness-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Our portable agent framework on Orchid and Herdr: routing, native activity, coordination and method",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:graph": "node scripts/check-project-graph.mjs",
    "check:lifecycle": "node scripts/check-lifecycle.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:docs": "node scripts/cli-reference.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "check:tutorial": "node scripts/check-tutorial.mjs",
    "check:label-registry": "node scripts/check-label-registry.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:profiles": "node --test scripts/profile-frontmatter.test.mjs && node scripts/check-profiles.mjs",
    "check:snapshots": "node --test scripts/check-snapshots.test.mjs && node scripts/check-snapshots.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "docs:cli": "pnpm run build:packages && node scripts/cli-reference.mjs --write",
    "build": "node scripts/run-stages.mjs --label build --compile-stage build:packages check:stages check:core-selection check:graph check:lifecycle check:links check:forms check:profiles check:snapshots check:compiled-policy build:packages check:publish check:label-registry check:docs check:skill check:tutorial",
    "typecheck": "node scripts/run-stages.mjs --label typecheck --compile-stage typecheck:compile check:stages check:core-selection check:graph check:lifecycle typecheck:compile",
    "check:cluster": "node --test method/tools/harness/blocked-decisions.test.mjs",
    "check:test-scripts": "node --test scripts/check-test-scripts.test.mjs && node scripts/check-test-scripts.mjs",
    "test": "node scripts/run-stages.mjs --label test check:stages check:core-selection check:test-scripts check:receipts check:cluster test:packages test:parity check:cli-aliases check:installed",
    "skill:install": "pnpm --filter @rickylabs/forge run build && node packages/forge/dist/cli.js skill install --dispatch-label harness",
    "clean": "node scripts/core-packages.mjs clean",
    "check:compiled-policy": "node --test scripts/check-compiled-policy.test.mjs && node scripts/check-compiled-policy.mjs",
    "check:installed": "node --test scripts/inconclusive.test.mjs && node scripts/check-installed-contracts.mjs",
    "check:stages": "node --test scripts/run-stages.test.mjs scripts/gates-regressions.test.mjs",
    "build:packages": "node scripts/core-packages.mjs build",
    "test:packages": "node scripts/core-packages.mjs test",
    "test:parity": "node --test tests/parity/consumer-surfaces.test.mjs",
    "typecheck:packages": "node scripts/core-packages.mjs typecheck",
    "typecheck:compile": "pnpm run typecheck:packages && tsc -p tsconfig.json",
    "check:receipts": "node --test method/tools/harness/matrix-receipts.test.mjs",
    "check:gate-mutations": "node scripts/mutation-verify-gates.mjs",
    "check:cli-aliases": "node --test scripts/cli-aliases.test.mjs",
    "check:core-selection": "node --test scripts/core-selection.test.mjs"
  },
  "devDependencies": {
    "@rickylabs/harness-contracts": "workspace:*",
    "@types/node": "^26.4.1",
    "js-yaml": "^4.3.2",
    "typescript": "~5.9.3"
  }
}
